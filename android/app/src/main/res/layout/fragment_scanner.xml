<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Podgląd kamery -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Komunikat o braku uprawnień -->
    <TextView
        android:id="@+id/tv_permission_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/scanner_permission_message"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Nakładka AR z wynikiem przeliczenia -->
    <TextView
        android:id="@+id/tv_overlay_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/overlay_background"
        android:textColor="@color/overlay_accent"
        android:textSize="28sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/tv_rate_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Informacja o kursie -->
    <TextView
        android:id="@+id/tv_rate_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/overlay_background"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@id/btn_manual_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Przycisk ręcznego wpisania -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_manual_input"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_manual_input"
        android:layout_margin="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
