        <item name="textAppearanceDisplayLarge">@style/TextAppearance.PRZevolut.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.PRZevolut.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.PRZevolut.DisplaySmall</item>
