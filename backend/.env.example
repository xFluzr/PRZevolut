# ========================
# Application Settings
# ========================
APP_NAME=PRZevolut API
DEBUG=True
API_VERSION=v1

# ========================
# Database
# ========================
# SQLite for local dev:
DATABASE_URL=sqlite:///./przevolut.db
# PostgreSQL for production (uncomment for Render/Fly.io):
# DATABASE_URL=postgresql://user:password@host:5432/przevolut

# ========================
# Security / JWT
# ========================
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ========================
# NBP API
# ========================
NBP_API_BASE_URL=https://api.nbp.pl/api
# Currencies to track (comma-separated ISO codes)
TRACKED_CURRENCIES=EUR,USD,GBP,CHF,CZK
# How often to fetch rates (in minutes, weekdays only)
RATE_FETCH_INTERVAL_MINUTES=60

# ========================
# CORS (for development)
# ========================
ALLOWED_ORIGINS=*
